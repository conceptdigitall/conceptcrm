# Worker de marketing/vídeo (npm run worker) para rodar fora do Mac (Railway ou VPS).
# Não expõe porta: só consulta o Supabase em loop. O app Next continua na Vercel
# (o Dockerfile da raiz é do app, não deste worker).
#
# Leva: Node 22, FFmpeg/ffprobe (narração, poster, duração), Chrome headless do
# HyperFrames (render), fontes (emoji e acentos) e yt-dlp (referências virais).
# Não leva: Docker (prospecção) e Laya (planilha). Essas ficam no Mac,
# separadas por WORKER_TASKS (veja docs/worker.md).
#
# Build local:  docker build -f Dockerfile.worker -t concept-worker .
# Segredos entram só em runtime (variáveis do Railway ou --env-file); nunca na imagem.

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=America/Sao_Paulo \
    NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PATH=/opt/yt-dlp/bin:$PATH

# Bibliotecas que o chrome-headless-shell precisa no Linux + ffmpeg + fontes + python p/ yt-dlp.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates tzdata curl \
      ffmpeg \
      python3 python3-venv \
      fontconfig fonts-liberation fonts-noto-core fonts-noto-color-emoji \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxext6 libx11-6 \
      libxcb1 libxshmfence1 libgbm1 libasound2 libpango-1.0-0 libcairo2 libexpat1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/yt-dlp \
    && /opt/yt-dlp/bin/pip install --no-cache-dir yt-dlp

WORKDIR /app
RUN chown node:node /app
USER node

# Dependências primeiro (cache). Precisa das devDependencies: tsx e hyperframes ficam lá.
COPY --chown=node:node package.json package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund --fetch-retries=5 --fetch-retry-maxtimeout=120000

# Chrome headless do render, instalado como no Dockerfile.render oficial do HyperFrames
# (@puppeteer/browsers + PRODUCER_HEADLESS_SHELL_PATH). O `hyperframes browser ensure`
# travava depois do download no Railway e o spinner dele estourava o limite de log;
# aqui a saída vai para um arquivo e só aparece se falhar.
ENV PRODUCER_HEADLESS_SHELL_PATH=/home/node/chrome-headless-shell
RUN npx --yes @puppeteer/browsers@2 install chrome-headless-shell@152.0.7977.30 \
      --path /home/node/.cache/puppeteer > /tmp/chrome-install.log 2>&1 \
      || (tail -n 40 /tmp/chrome-install.log; exit 1); \
    BIN=$(find /home/node/.cache/puppeteer -name chrome-headless-shell -type f | head -1); \
    test -n "$BIN" || (echo "chrome-headless-shell não encontrado" >&2; tail -n 40 /tmp/chrome-install.log; exit 1); \
    ln -s "$BIN" "$PRODUCER_HEADLESS_SHELL_PATH" \
    && "$PRODUCER_HEADLESS_SHELL_PATH" --version

COPY --chown=node:node . .

# Falha o build se o .dockerignore errado tiver cortado os prompts ou os pacotes de nicho.
RUN test -f worker/prompts/hyperframes-core.md \
 && test -d src/lib/marketing/packs \
 && test -f worker/music/tracks.json \
 && ffmpeg -version >/dev/null && ffprobe -version >/dev/null && yt-dlp --version >/dev/null

# Sem --env-file: no servidor as variáveis já vêm do ambiente.
CMD ["./node_modules/.bin/tsx", "worker/index.ts"]
